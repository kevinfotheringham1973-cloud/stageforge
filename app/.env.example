# Local Postgres. See README for setup.
DATABASE_URL="postgresql://stageforge:stageforge@localhost:5432/stageforge?schema=public"

# Required for AI-assisted project provisioning (/projects/new — see
# ProvisioningModel.html). Get a key from https://console.anthropic.com/.
# Without it, creating a project draft fails with an authentication error
# from the Anthropic SDK — everything else in the app works fine without it.
ANTHROPIC_API_KEY=""
