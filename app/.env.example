# Local Postgres. See README for setup.
DATABASE_URL="postgresql://stageforge:stageforge@localhost:5432/stageforge?schema=public"

# Required for AI-assisted project provisioning (/projects/new — see
# ProvisioningModel.html). Get a key from https://console.anthropic.com/.
# Without it, creating a project draft fails with an authentication error
# from the Anthropic SDK — everything else in the app works fine without it.
ANTHROPIC_API_KEY=""

# Microsoft Graph API — evidence storage in SharePoint (app-only /
# client credentials flow, no user sign-in). From the app registration's
# Overview page (AZURE_TENANT_ID, AZURE_CLIENT_ID) and Certificates &
# secrets (AZURE_CLIENT_SECRET — the Value column, not the Secret ID).
# Without these, evidence upload stays a DB-only stub (see actions.ts).
AZURE_TENANT_ID=""
AZURE_CLIENT_ID=""
AZURE_CLIENT_SECRET=""
# The target SharePoint site and document library.
SHAREPOINT_SITE_ID=""
SHAREPOINT_DRIVE_ID=""

# Real authentication (auth.ts / session.ts). AUTH_SECRET encrypts
# session cookies/tokens -- generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# AUTH_TRUST_HOST is required when self-hosting behind a reverse proxy
# or tunnel (Cloudflare Tunnel today, Azure App Service later) --
# without it Auth.js rejects requests whose Host header doesn't match
# what it expects. AUTH_URL pins the base URL Auth.js uses to build
# every link (magic-link emails, OAuth callbacks) -- without it, a
# request that reaches the app by a different host than expected (e.g.
# localhost directly, bypassing a tunnel) makes Auth.js guess the
# origin, which in production can produce a broken link with no TLS
# behind it. Set it to whatever origin you're actually reached on.
AUTH_SECRET=""
AUTH_TRUST_HOST="true"
AUTH_URL="http://localhost:3001"

# Passwordless magic-link email sign-in (auth.ts's Resend provider) --
# no password is ever created, hashed, or stored anywhere; this is the
# primary sign-in path, not a fallback. Get a key from resend.com. To
# deliver to anyone other than the Resend account's own signup address,
# verify a sending domain there first and set RESEND_FROM_EMAIL to an
# address on it -- otherwise Resend's sandbox mode 403s every recipient
# except the account owner. Without RESEND_API_KEY, only Microsoft
# sign-in (below) shows on /login.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="StageForge <onboarding@resend.dev>"

# Microsoft sign-in for real Trust/FM Contractor users (a SEPARATE app
# registration, or the existing one above with a Web platform redirect
# URI + delegated User.Read scope added -- app-only Graph credentials
# above can't do user sign-in). Redirect URI to register:
#   <your-app-url>/api/auth/callback/microsoft-entra-id
# Without these, only the email-link sign-in (above) shows on /login.
AUTH_MICROSOFT_ENTRA_ID_ID=""
AUTH_MICROSOFT_ENTRA_ID_SECRET=""

# Self-contained desktop build ONLY (electron/) -- never set this for the
# real deployed app. Skips Entra ID / Resend entirely and auto-signs in
# as a fixed local admin user (see LOCAL_ADMIN_EMAIL in auth.ts). AUTH_SECRET
# above is still required -- NextAuth needs it regardless of provider.
STAGEFORGE_LOCAL_MODE=""

# Desktop build ONLY -- set by electron/main.js to a folder under the
# OS's per-user app-data directory. Evidence uploads are saved there
# instead of SharePoint when STAGEFORGE_LOCAL_MODE is on and SharePoint
# isn't configured (see localEvidenceStorage.ts). Without it, local mode
# falls back to a .local-evidence/ folder in the app directory itself.
STAGEFORGE_EVIDENCE_DIR=""
