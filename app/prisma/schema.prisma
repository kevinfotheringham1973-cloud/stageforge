// StageForge schema.
// Direct translation of DataModel.html (v0.5) and ConfigSchema.html (v0.4).
// Phase 1: Stage-Gate Engine, Deliverable/Evidence, tiered bypass
// authority, Sponsor sign-off, audit trail, multi-tenancy.
// Phase 2 (added 19 Aug 2026): the Compliance corpus — ComplianceRuleSet,
// ComplianceRuleTemplate, ComplianceRequirement, ComplianceOverride —
// schema only so far; not yet wired into gate-closure logic
// (permissions.ts), actions, or the UI. See §06 of PRD.html.
//
// Deliberately NOT in this schema (Phase 2–3+, per the PRD roadmap):
// ResourceAllocation, SpendRecord.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Tenancy & access ────────────────────────────────────────────────
// Company/Department never link directly to Project — access is granted
// through ProjectRoleAssignment, scoped per project. See DataModel.html §02.

enum CompanyType {
  FM_CONTRACTOR
  CLIENT_AUTHORITY
}

model Company {
  id          String       @id @default(cuid())
  name        String
  type        CompanyType
  departments Department[]
  createdAt   DateTime     @default(now())
}

model Department {
  id              String                  @id @default(cuid())
  companyId       String
  company         Company                 @relation(fields: [companyId], references: [id])
  name            String
  users           User[]
  roleAssignments ProjectRoleAssignment[]
  createdAt       DateTime                @default(now())
}

model User {
  id                         String                   @id @default(cuid())
  name                       String
  email                      String                   @unique
  homeDepartmentId           String?
  homeDepartment             Department?              @relation(fields: [homeDepartmentId], references: [id])
  isPlatformAdmin            Boolean                  @default(false)
  roleAssignments            ProjectRoleAssignment[]
  evidenceUploads            EvidenceFile[]
  bypasses                   DeliverableBypass[]
  signOffs                   GateSignOff[]
  auditEntries               AuditLogEntry[]
  complianceUploads          ComplianceEvidenceFile[]
  complianceOverrides        ComplianceOverride[]
  createdProjects            Project[]                @relation("ProjectCreatedBy")
  provisioningReviews        ProvisioningReview[]
  resourceAllocations        ResourceAllocation[]
  resourceAllocationsUpdated ResourceAllocation[]     @relation("ResourceAllocationUpdatedBy")
  recordedSpend              SpendRecord[]            @relation("SpendRecordedBy")
  spendApprovals             SpendApproval[]          @relation("SpendApprovedBy")
  lessonsLearned             LessonLearned[]
  createdAt                  DateTime                 @default(now())
}

// Global role definitions. A Role can optionally be scoped to a
// SectorVariant (nullable sectorVariantId) — see DataModel.html §02
// decided note on sector-specific roles. Phase 1 only seeds the core
// eight, all global.
model Role {
  id              String                  @id @default(cuid())
  key             String                  @unique // e.g. "PM", "SPONSOR", "SRO"
  name            String
  sectorVariantId String?
  sectorVariant   SectorVariant?          @relation(fields: [sectorVariantId], references: [id])
  assignments     ProjectRoleAssignment[]
}

// The access join — resolves the tenancy question. Grants one User
// (from one Department) one Role on one Project.
model ProjectRoleAssignment {
  id           String     @id @default(cuid())
  projectId    String
  project      Project    @relation(fields: [projectId], references: [id])
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])
  userId       String
  user         User       @relation(fields: [userId], references: [id])
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id])
  createdAt    DateTime   @default(now())

  @@unique([projectId, userId, roleId])
}

// ── Delivery ─────────────────────────────────────────────────────────

model SectorVariant {
  id                 String              @id @default(cuid())
  key                String              @unique // e.g. "health"
  name               String
  brandName          String
  templates          Template[]
  roles              Role[]
  complianceRuleSets ComplianceRuleSet[]
}

// The named template a Project is built from, e.g.
// "template.health.ward_refurbishment". Authoring (create/edit) is
// Platform Admin + Compliance Officer only.
model Template {
  id              String          @id @default(cuid())
  key             String          @unique
  name            String
  // Matching metadata for AI-assisted provisioning (ProvisioningModel.html
  // §04) — what an LLM matches a free-text project description against
  // when picking the closest Template from the library. Not used by
  // anything else; a Template with no matchKeywords just isn't a
  // provisioning candidate yet.
  description     String?
  matchKeywords   String[]        @default([])
  sectorVariantId String
  sectorVariant   SectorVariant   @relation(fields: [sectorVariantId], references: [id])
  stageTemplates  StageTemplate[]
  projects        Project[]
}

model StageTemplate {
  id           String        @id @default(cuid())
  templateId   String
  template     Template      @relation(fields: [templateId], references: [id])
  key          String // e.g. "stage.design_planning"
  name         String
  order        Int
  gateTemplate GateTemplate?
  stages       Stage[]

  @@unique([templateId, key])
}

model GateTemplate {
  id                   String                @id @default(cuid())
  stageTemplateId      String                @unique
  stageTemplate        StageTemplate         @relation(fields: [stageTemplateId], references: [id])
  key                  String
  name                 String
  deliverableTemplates DeliverableTemplate[]
}

enum BypassAuthority {
  PM
  COMPLIANCE_OFFICER
  SRO
}

// The shared checklist-item primitive (ConfigSchema.html §02), scoped
// to delivery for Phase 1 — compliance's use of this same shape is
// Phase 2. bypassAuthority carries what DataModel.html called
// "legally significant": PM means ordinary, anything else means a PM
// cannot bypass it.
model DeliverableTemplate {
  id              String          @id @default(cuid())
  gateTemplateId  String
  gateTemplate    GateTemplate    @relation(fields: [gateTemplateId], references: [id])
  key             String
  label           String
  description     String?
  minFiles        Int             @default(1)
  blocksGate      Boolean         @default(true)
  bypassAuthority BypassAuthority @default(PM)
  deliverables    Deliverable[]

  @@unique([gateTemplateId, key])
}

// ── Compliance corpus ────────────────────────────────────────────────
// The second of the "one primitive, two libraries" pair (ConfigSchema.html
// §01): delivery checklist items live inside a StageTemplate, maintained
// per programme type; compliance checklist items live inside a
// ComplianceRuleSet, maintained per sector/jurisdiction, independently of
// any one programme template. A ComplianceRuleSet is largely static —
// it reflects standing regulation (SHTM series, Building (Scotland) Act,
// HAI-SCRIBE, etc.), not something authored per project. Authoring is
// Platform Admin + Compliance Officer only, same as StageTemplate.

enum ComplianceEvidenceType {
  FILE_UPLOAD
  ATTESTATION
  EXTERNAL_CHECK
}

model ComplianceRuleSet {
  id              String                   @id @default(cuid())
  key             String                   @unique // e.g. "compliance.health.fire_safety"
  name            String
  sectorVariantId String
  sectorVariant   SectorVariant            @relation(fields: [sectorVariantId], references: [id])
  rules           ComplianceRuleTemplate[]
  createdAt       DateTime                 @default(now())
}

// A rule attaches to stages by key (appliesToStageKeys), not by nesting —
// so the same rule can apply across every programme type that includes
// that stage, without being copy-pasted into each StageTemplate
// (ConfigSchema.html §04). appliesIfTags is the "any match" extensibility
// mechanism: a Project carrying at least one matching tag pulls this rule
// in; empty/absent means it always applies.
model ComplianceRuleTemplate {
  id                 String                  @id @default(cuid())
  ruleSetId          String
  ruleSet            ComplianceRuleSet       @relation(fields: [ruleSetId], references: [id])
  key                String
  label              String
  description        String?
  ruleRef            String? // citation, e.g. "HTM 05-03", "SHTM 06-01"
  evidenceType       ComplianceEvidenceType  @default(FILE_UPLOAD)
  minFiles           Int                     @default(1)
  blocksGate         Boolean                 @default(true)
  appliesToStageKeys String[] // StageTemplate keys this rule can attach to
  appliesIfTags      String[] // Project.tags to match, "any match"; empty = always applies
  requirements       ComplianceRequirement[]

  @@unique([ruleSetId, key])
}

enum ComplianceRequirementStatus {
  PENDING
  EVIDENCED
  OVERRIDDEN
}

// The compliance equivalent of Deliverable. At Stage instantiation, one
// row is copied here for every ComplianceRuleTemplate whose
// appliesToStageKeys and appliesIfTags match the Project — frozen at that
// point, never a live join back to the template (ConfigSchema.html §05),
// for the same audit-trail reason Deliverable is frozen. Attaches to
// Gate rather than Stage directly: Gate is 1:1 with Stage, and this
// keeps it symmetric with Deliverable and with ComplianceOverride below,
// both of which act at gate level.
model ComplianceRequirement {
  id            String                      @id @default(cuid())
  gateId        String
  gate          Gate                        @relation(fields: [gateId], references: [id])
  templateId    String?
  template      ComplianceRuleTemplate?     @relation(fields: [templateId], references: [id])
  key           String
  label         String
  description   String?
  ruleRef       String?
  evidenceType  ComplianceEvidenceType      @default(FILE_UPLOAD)
  minFiles      Int                         @default(1)
  blocksGate    Boolean                     @default(true)
  status        ComplianceRequirementStatus @default(PENDING)
  evidenceFiles ComplianceEvidenceFile[]
  createdAt     DateTime                    @default(now())
}

model ComplianceEvidenceFile {
  id                      String                @id @default(cuid())
  complianceRequirementId String
  complianceRequirement   ComplianceRequirement @relation(fields: [complianceRequirementId], references: [id])
  fileName                String
  fileRef                 String
  version                 Int                   @default(1)
  uploadedById            String
  uploadedBy              User                  @relation(fields: [uploadedById], references: [id])
  uploadedAt              DateTime              @default(now())
}

// One SRO action clears every outstanding ComplianceRequirement on a
// Gate at once — not a per-requirement bypass like DeliverableBypass
// (DataModel.html §03 decided note). coveredRequirementIds snapshots
// exactly which requirements were outstanding at the moment of
// override, so the audit trail shows what was actually accepted even
// if new requirements are added to the stage later.
model ComplianceOverride {
  id                    String   @id @default(cuid())
  gateId                String
  gate                  Gate     @relation(fields: [gateId], references: [id])
  overriddenById        String
  overriddenBy          User     @relation(fields: [overriddenById], references: [id])
  reason                String
  coveredRequirementIds String[]
  createdAt             DateTime @default(now())
}

// A managed, incrementing project-number sequence (confirmed by Kevin,
// 19 Aug 2026 — replacing the old free-text "type your own project
// number" field, which had no collision/typo protection beyond the DB
// unique constraint). Single-row counter rather than a Postgres
// SEQUENCE object so it's visible/resettable through the same Prisma
// migrations and seed.ts as everything else. Starts a fresh block at
// 30001 — deliberately unrelated to the pre-existing ad-hoc numbers
// (20456, 20777, 55998) already in the seed data, so newly-issued
// numbers are visibly distinct from those legacy ones. Issuing a
// number is an atomic `UPDATE ... SET value = value + 1 RETURNING
// value` (via Prisma's `increment`), safe under concurrent creates —
// see issueNextProjectNumber in lib/actions.ts.
model ProjectNumberCounter {
  id    Int @id @default(1)
  value Int
}

// AI-assisted provisioning (ProvisioningModel.html §04). Every existing/
// seeded/reinstated project is unaffected — only the provisioning path
// (not built yet beyond this schema + the shared instantiation helper)
// ever creates a DRAFT project. No REJECTED-style terminal state here
// either, same reasoning as GateStatus below: a revision request is a
// ProvisioningReview(REVISE, reason) row, the Project just stays DRAFT.
enum ProjectStatus {
  DRAFT
  ACTIVE
}

// The CDM 2015 statutory question, asked at project creation — three
// options because CDM 2015's Principal Designer/Principal Contractor
// duty (reg 5) triggers on "more than one contractor", independently
// of whether the building itself is touched: a like-for-like swap
// needing two trades on site still needs a Principal Designer, even
// though it's not BUILDING_MODIFICATION and never raises planning
// permission (confirmed by Kevin, 19 Aug 2026 — corrects an earlier
// version of this field that conflated "modifies the building" with
// "CDM applies").
//   - DIRECT_REPLACEMENT_SINGLE_CONTRACTOR: neither duty applies.
//   - DIRECT_REPLACEMENT_MULTIPLE_CONTRACTORS: Principal Designer
//     required; no building fabric change, so no planning question.
//   - BUILDING_MODIFICATION: both — Principal Designer required, and
//     planning permission becomes a live question.
// Defaults to the lightest-duty answer only so existing/seeded rows
// have a value; the creation form always requires an explicit choice.
enum CdmWorksType {
  DIRECT_REPLACEMENT_SINGLE_CONTRACTOR
  DIRECT_REPLACEMENT_MULTIPLE_CONTRACTORS
  BUILDING_MODIFICATION
}

model Project {
  id                         String                  @id @default(cuid())
  projectNumber              String                  @unique
  name                       String
  templateId                 String
  template                   Template                @relation(fields: [templateId], references: [id])
  // Stage scoping (ConfigSchema.html §06): which of the template's
  // stage keys this project actually uses. Editable — a PM can
  // reinstate a skipped stage later; it appends after the project's
  // current point rather than reinserting into template order.
  includedStageKeys          String[]
  // Compliance rule matching (ConfigSchema.html §04): a
  // ComplianceRuleTemplate with a non-empty appliesIfTags applies if at
  // least one tag here matches ("any match", no AND/OR/NOT). e.g.
  // "acute_hospital", "listed_building", "occupied_during_works".
  tags                       String[]                @default([])
  // See CdmWorksType above. Kept as its own field rather than folded
  // into `tags` — it's an explicit statutory answer the creator/
  // Compliance Officer gives, not something an LLM should guess from
  // free text (see lib/provisioning.ts, which excludes the derived tag
  // from its tag-matching vocabulary for exactly this reason).
  worksType                  CdmWorksType            @default(DIRECT_REPLACEMENT_SINGLE_CONTRACTOR)
  status                     ProjectStatus           @default(ACTIVE)
  createdById                String?
  createdBy                  User?                   @relation("ProjectCreatedBy", fields: [createdById], references: [id])
  provisioningBrief          String?
  provisioningMatchReasoning String?
  provisioningReviews        ProvisioningReview[]
  roleAssignments            ProjectRoleAssignment[]
  resourceAllocations        ResourceAllocation[]
  stages                     Stage[]
  createdAt                  DateTime                @default(now())
}

// Financial View (FinancialModel.html, revised per Kevin: spend is
// checked and approved at each gate, not just recorded against the
// project as a whole). Manual/invoice-level actuals only — no ERP
// integration (PRD.html §06/§08 decided, not near-term). Attaches to
// Gate rather than Project directly, the same shape as Deliverable and
// ComplianceRequirement — a project's total is the sum across its
// gates' records, reached via Gate -> Stage -> Project, not a direct FK.
enum ApprovalBucket {
  LIFECYCLE_REPLACEMENT
  SMALL_WORKS
  VARIATION
}

// One row per invoice/actual, not per gate — a gate's total is the sum
// of its records. blocksGate mirrors Deliverable/ComplianceRequirement:
// an unapproved blocking record holds the gate at NOT_STARTED/
// IN_PROGRESS the same way an unevidenced deliverable does. No REJECTED
// terminal status, same reasoning as every other status enum in this
// app: a rejection is a SpendApproval(REJECTED, reason) row and the
// record just stays PENDING, editable, not a dead end.
model SpendRecord {
  id               String            @id @default(cuid())
  gateId           String
  gate             Gate              @relation(fields: [gateId], references: [id])
  bucket           ApprovalBucket
  // Money needs exact arithmetic — Decimal (Postgres numeric), not
  // Int/Float. GBP only, no multi-currency (every source document is
  // UK-only).
  amount           Decimal           @db.Decimal(12, 2)
  description      String
  invoiceReference String?
  blocksGate       Boolean           @default(true)
  recordedById     String
  recordedBy       User              @relation("SpendRecordedBy", fields: [recordedById], references: [id])
  status           SpendRecordStatus @default(PENDING)
  approvals        SpendApproval[]
  createdAt        DateTime          @default(now())
}

enum SpendRecordStatus {
  PENDING
  APPROVED
}

enum SpendApprovalDecision {
  APPROVED
  REJECTED
}

// The decision history for a SpendRecord — shaped exactly like
// GateSignOff/ProvisioningReview: read the latest row instead of
// duplicating state on SpendRecord itself.
model SpendApproval {
  id            String                @id @default(cuid())
  spendRecordId String
  spendRecord   SpendRecord           @relation(fields: [spendRecordId], references: [id])
  decision      SpendApprovalDecision
  approvedById  String
  approvedBy    User                  @relation("SpendApprovedBy", fields: [approvedById], references: [id])
  reason        String?
  createdAt     DateTime              @default(now())
}

// Resource/Capacity View (ResourceCapacityModel.html). Keyed by (User,
// Project) rather than ProjectRoleAssignment — someone holding two
// delivery-facing roles on the same project still has one allocation
// number, not one per role. Current-state only, no time period: a
// straight overwrite, matching the "no forecasting" boundary
// (PRD.html §11) — see AuditLogEntry for the change history instead.
model ResourceAllocation {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id])
  projectId         String
  project           Project  @relation(fields: [projectId], references: [id])
  allocationPercent Int
  updatedById       String
  updatedBy         User     @relation("ResourceAllocationUpdatedBy", fields: [updatedById], references: [id])
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([userId, projectId])
}

enum ProvisioningReviewDecision {
  APPROVED
  REVISE
}

// The human decision history for a project's provisioning match —
// deliberately shaped like GateSignOff (no flat reviewedBy/reviewedAt
// columns on Project itself; read the latest row instead of
// duplicating state, same reasoning as why Gate has no such columns).
model ProvisioningReview {
  id           String                     @id @default(cuid())
  projectId    String
  project      Project                    @relation(fields: [projectId], references: [id])
  decision     ProvisioningReviewDecision
  reviewedById String
  reviewedBy   User                       @relation(fields: [reviewedById], references: [id])
  reason       String?
  createdAt    DateTime                   @default(now())
}

// No REJECTED status here on purpose: per the PRD, rejecting a gate
// returns it to IN_PROGRESS with the Sponsor's reason attached — the
// rejection itself is recorded as a GateSignOff row (decision:
// REJECTED), not a lingering gate state.
enum GateStatus {
  NOT_STARTED
  IN_PROGRESS
  AWAITING_SPONSOR
  SIGNED_OFF
}

model Stage {
  id                    String         @id @default(cuid())
  projectId             String
  project               Project        @relation(fields: [projectId], references: [id])
  // Informational only — content is copied at instantiation, never
  // re-resolved live. See ConfigSchema.html §05 recommendation.
  sourceStageTemplateId String?
  sourceStageTemplate   StageTemplate? @relation(fields: [sourceStageTemplateId], references: [id])
  key                   String
  name                  String
  order                 Int
  gate                  Gate?
  createdAt             DateTime       @default(now())

  // Belt-and-braces against double-instantiation (a real bug hit in
  // practice: a project ended up with duplicate Stage/Gate rows for
  // its first four stages after a request was interrupted mid-loop
  // and retried). reinstateStage already checks this in application
  // code before creating a Stage, but that check has a race window;
  // this makes the invariant impossible to violate regardless of
  // cause, for both reinstateStage and approveProvisioning.
  @@unique([projectId, key])
}

model Gate {
  id                     String                  @id @default(cuid())
  stageId                String                  @unique
  stage                  Stage                   @relation(fields: [stageId], references: [id])
  key                    String
  name                   String
  status                 GateStatus              @default(NOT_STARTED)
  // Timeline (planned vs. actual). Target dates are PM-set planning
  // input; actual dates are stamped automatically by the app itself
  // (never user-entered) the moment the gate really starts/finishes —
  // see startGateUpdate and decide() in actions.ts — so "actual" stays
  // trustworthy, not something anyone can backdate.
  targetStartDate        DateTime?
  targetEndDate          DateTime?
  actualStartDate        DateTime?
  actualEndDate          DateTime?
  deliverables           Deliverable[]
  complianceRequirements ComplianceRequirement[]
  complianceOverrides    ComplianceOverride[]
  spendRecords           SpendRecord[]
  signOffs               GateSignOff[]
  auditEntries           AuditLogEntry[]
  lessonsLearned         LessonLearned[]
  createdAt              DateTime                @default(now())
}

enum DeliverableStatus {
  PENDING
  EVIDENCED
  BYPASSED
}

model Deliverable {
  id              String               @id @default(cuid())
  gateId          String
  gate            Gate                 @relation(fields: [gateId], references: [id])
  templateId      String?
  template        DeliverableTemplate? @relation(fields: [templateId], references: [id])
  key             String
  label           String
  description     String?
  minFiles        Int                  @default(1)
  blocksGate      Boolean              @default(true)
  bypassAuthority BypassAuthority      @default(PM)
  status          DeliverableStatus    @default(PENDING)
  evidenceFiles   EvidenceFile[]
  bypass          DeliverableBypass?
  createdAt       DateTime             @default(now())
}

model EvidenceFile {
  id            String      @id @default(cuid())
  deliverableId String
  deliverable   Deliverable @relation(fields: [deliverableId], references: [id])
  fileName      String
  fileRef       String // storage path/URL — local disk in dev, object storage later
  version       Int         @default(1)
  uploadedById  String
  uploadedBy    User        @relation(fields: [uploadedById], references: [id])
  uploadedAt    DateTime    @default(now())
}

// Reason is mandatory — confirmed by Kevin, for traceability. Whoever
// bypasses must hold the role named by the deliverable's
// bypassAuthority; enforced in application code (lib/permissions.ts),
// not the schema.
model DeliverableBypass {
  id            String      @id @default(cuid())
  deliverableId String      @unique
  deliverable   Deliverable @relation(fields: [deliverableId], references: [id])
  bypassedById  String
  bypassedBy    User        @relation(fields: [bypassedById], references: [id])
  reason        String
  createdAt     DateTime    @default(now())
}

enum SignOffDecision {
  APPROVED
  REJECTED
}

// Reject requires a reason too (confirmed by Kevin) — same
// mandatory-reason pattern as every bypass/override in the model.
model GateSignOff {
  id            String          @id @default(cuid())
  gateId        String
  gate          Gate            @relation(fields: [gateId], references: [id])
  decision      SignOffDecision
  signedOffById String
  signedOffBy   User            @relation(fields: [signedOffById], references: [id])
  reason        String?
  createdAt     DateTime        @default(now())
}

enum LessonType {
  WENT_WELL
  TO_IMPROVE
}

// Reflective knowledge capture, not a governance action — no
// blocksGate, no bypass authority, addable at any point in a gate's
// life (not just at sign-off). The point of this table is cross-
// project learning: Gate.key is the same RIBA stage key across every
// Template (M&E/Water/Drainage all reuse "stage.spatial_coordination"
// etc.), so grouping LessonLearned rows by that key surfaces "what
// went wrong/well at Spatial Coordination" across the whole portfolio,
// not just within one project — see /lessons-learned.
model LessonLearned {
  id           String     @id @default(cuid())
  gateId       String
  gate         Gate       @relation(fields: [gateId], references: [id])
  type         LessonType
  text         String
  recordedById String
  recordedBy   User       @relation(fields: [recordedById], references: [id])
  createdAt    DateTime   @default(now())
}

// Append-only. One row per upload, bypass, sign-off, and rejection.
model AuditLogEntry {
  id         String   @id @default(cuid())
  actorId    String
  actor      User     @relation(fields: [actorId], references: [id])
  action     String // e.g. "evidence.uploaded", "deliverable.bypassed", "gate.signed_off"
  gateId     String?
  gate       Gate?    @relation(fields: [gateId], references: [id])
  entityType String
  entityId   String
  reason     String?
  createdAt  DateTime @default(now())
}
